# ============ 投资管家 · 环境变量示例 ============
# 复制为 .env 后按需修改；docker-compose 会自动读取同目录 .env

# 服务端口（宿主机映射端口）
PORT=8080

# JWT 签名密钥（至少 32 位随机值）。
# 留空：服务首次启动会自动生成随机密钥并持久化到 data/.jwt-secret（重建容器不变，推荐）。
# 多实例共享数据卷、或需要固定密钥时，才在此显式填写（生成示例：openssl rand -hex 32）。
# 注意：请勿填写含 secret/change/please 字样的示例值，服务会判定为弱密钥并改用自动生成。
JWT_SECRET=
# JWT 有效期（默认 7 天）
JWT_EXPIRES_IN=7d

# 系统配置加密密钥（用于加密 SMTP 密码等，留空则回退使用 JWT_SECRET）
CONFIG_SECRET=

# 首启管理员账号（仅在数据库中不存在任何管理员时初始化）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# SQLite 数据库文件（容器内路径，一般无需修改）
DB_PATH=/app/data/invest.db

# ============ 汇率源 ============
FX_SOURCE_URL=https://api.frankfurter.app/latest?from=USD&to=CNY
FX_FALLBACK_URL=https://open.er-api.com/v6/latest/USD
# 每日汇率同步 cron（默认每天 08:00）
FX_SYNC_CRON=0 8 * * *
# 行情同步：股票（每15分钟）/ 基金（每日收盘净值一次）
QUOTES_STOCK_CRON=*/15 * * * *
QUOTES_FUND_CRON=5 21 * * *
# 启动时是否立即同步一次汇率（true/false）
FX_SYNC_ON_START=false

# ============ 定时任务与备份 ============
# 定时任务总开关（false 可关闭：汇率同步 / 月末快照 / 基准点位同步 / 定投生成 / 预警扫描 / 自动备份）
CRON_ENABLED=true
# 自动备份保留天数（超过则清理最旧的备份）
BACKUP_KEEP_DAYS=30

# ============ SMTP 邮箱验证码（也可在管理后台配置） ============
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 时区
TZ=Asia/Shanghai
